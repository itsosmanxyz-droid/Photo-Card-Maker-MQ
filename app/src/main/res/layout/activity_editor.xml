<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/surface" android:gravity="center_vertical"
        android:orientation="horizontal" android:padding="4dp">
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="44dp" android:layout_height="44dp"
            android:gravity="center" android:text="←" android:textColor="@color/text" android:textSize="24sp"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
        <TextView
            android:id="@+id/btnUndo"
            android:layout_width="44dp" android:layout_height="44dp"
            android:gravity="center" android:text="↶" android:textColor="@color/text" android:textSize="24sp"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
        <TextView
            android:id="@+id/btnRedo"
            android:layout_width="44dp" android:layout_height="44dp"
            android:gravity="center" android:text="↷" android:textColor="@color/text" android:textSize="24sp"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView
            android:id="@+id/btnSave"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_chip" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="9dp" android:paddingBottom="9dp"
            android:text="@string/save" android:textColor="@color/text" android:textStyle="bold"
            android:clickable="true" android:focusable="true" />
        <TextView
            android:id="@+id/btnExport"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:layout_marginEnd="6dp"
            android:background="@drawable/bg_primary_btn" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="9dp" android:paddingBottom="9dp"
            android:text="@string/export" android:textColor="@color/white" android:textStyle="bold"
            android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <com.osman.photocardmaker.editor.EditorView
        android:id="@+id/editor"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/selPanel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/surface" android:orientation="vertical"
        android:paddingTop="4dp" android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="12dp" android:paddingEnd="12dp">
            <TextView
                android:layout_width="60dp" android:layout_height="wrap_content"
                android:text="@string/label_size" android:textColor="@color/text2" android:textSize="12sp" />
            <SeekBar android:id="@+id/sizeSeek"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:max="500" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="12dp" android:paddingEnd="12dp">
            <TextView
                android:layout_width="60dp" android:layout_height="wrap_content"
                android:text="@string/label_rotate" android:textColor="@color/text2" android:textSize="12sp" />
            <SeekBar android:id="@+id/rotSeek"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:max="360" />
        </LinearLayout>
        <HorizontalScrollView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/selBar"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingStart="6dp" android:paddingEnd="6dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/surface" android:scrollbars="none">
        <LinearLayout
            android:id="@+id/toolsBar"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingStart="6dp" android:paddingEnd="6dp"
            android:paddingBottom="4dp" />
    </HorizontalScrollView>
</LinearLayout>
